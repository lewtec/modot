package view

import (
	"fmt"
	"path/filepath"
	"sort"
	"strings"

	"github.com/lewtec/lewkit/x/http/asset/lucide"
	"github.com/lewtec/modot/internal/configdash"
)

// View is one rendered page's data.
type View struct {
	Report configdash.Report
	Theme  string
	// LoadErr is set when discovery or evaluation failed. The page shows the
	// error above whatever Partial holds.
	LoadErr error
	// Partial is the Report Load returned with its error: the layers and
	// modules are known even when the merge is not.
	Partial *configdash.Report
	// ModuleName is the module selected on the modules page.
	ModuleName string
	// Path is the merged subtree selected on the merged page.
	Path string
	// Scope is the layer set this page shows.
	Scope configdash.Scope
}

// shown is the report to render: the loaded one, else the partial one.
func (v View) shown() configdash.Report {
	if v.Partial != nil {
		return *v.Partial
	}
	return v.Report
}

func statCards(r configdash.Report) []statCard {
	enabled, disabled := 0, 0
	for _, mod := range r.Modules {
		if mod.Enable {
			enabled++
		} else {
			disabled++
		}
	}
	return []statCard{
		{Title: "Layers", Value: fmt.Sprint(len(r.Layers)), Desc: "discovered modot.cue", Accent: "text-primary"},
		{Title: "Modules", Value: fmt.Sprint(enabled), Desc: fmt.Sprintf("%d disabled, %d not loaded", disabled, r.ProblemCount()), Accent: "text-secondary"},
		{Title: "Keys", Value: fmt.Sprint(r.Stats.Keys), Desc: "in the merged tree", Accent: "text-accent"},
		{Title: "From modules", Value: fmt.Sprint(r.Stats.FromModules), Desc: "options.<name> and declared roots", Accent: "text-info"},
	}
}

type statCard struct {
	Title  string
	Value  string
	Desc   string
	Accent string
}

// topLevel returns the merged top-level keys, sorted.
func topLevel(r configdash.Report) []string {
	keys := make([]string, 0, len(r.Merged))
	for key := range r.Merged {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

func shortValue(v any) string {
	switch value := v.(type) {
	case nil:
		return "null"
	case map[string]any:
		return fmt.Sprintf("{%d fields}", len(value))
	case []any:
		return fmt.Sprintf("[%d items]", len(value))
	case string:
		if len(value) > 60 {
			return fmt.Sprintf("%q…", value[:60])
		}
		return fmt.Sprintf("%q", value)
	case bool:
		return fmt.Sprint(value)
	}
	return fmt.Sprint(v)
}

// ownedLeaves counts the leaves under prefix that a module supplied.
func ownedLeaves(r configdash.Report, prefix string) int {
	count := 0
	for path, src := range r.Sources {
		if !src.Owned() {
			continue
		}
		if path == prefix || strings.HasPrefix(path, prefix+".") {
			count++
		}
	}
	return count
}

templ Overview(v View) {
	@Shell("Overview", pageOverview, v.Theme, v) {
		@PageHeader("Merged configuration", overviewLead(v.shown()))
		@PageBody() {
			if v.LoadErr != nil && v.shown().MergedErr == nil {
				@errorAlert(v.LoadErr)
			}
			@statsRow(statCards(v.shown()))
			@layerStrip(v.shown())
			if v.shown().ProblemCount() > 0 {
				@problemCard(v.shown())
			}
			if len(v.shown().Unused) > 0 {
				@unusedCard(v.shown())
			}
			if v.shown().MergedErr != nil {
				@errorAlertTitled("Merge failed", v.shown().MergedErr)
			}
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				@topKeysCard(v.shown())
				@moduleSummaryCard(v.shown())
			</div>
		}
	}
}

// overviewLead names the scope and mode, or says that nothing was found.
func overviewLead(r configdash.Report) string {
	if r.Scope == "" {
		return "No modot.cue found for this scope."
	}
	return fmt.Sprintf("Scope %s · mode %s · %d layers → one Configuration.", r.Scope, r.Mode, len(r.Layers))
}

templ errorAlert(err error) {
	@errorAlertTitled("Load failed", err)
}

// errorAlertTitled is errorAlert with a caller-chosen heading.
templ errorAlertTitled(title string, err error) {
	<div class="alert alert-error items-start" role="alert">
		@icon(lucide.NameTriangleAlert, "size-5")
		<div class="min-w-0">
			<p class="font-semibold">{ title }</p>
			<pre class="max-w-full overflow-x-auto text-xs whitespace-pre-wrap">{ err.Error() }</pre>
		</div>
	</div>
}

// problems returns the modules that failed to load, sorted by name.
func problems(r configdash.Report) []configdash.Module {
	out := make([]configdash.Module, 0, r.ProblemCount())
	for _, mod := range r.Modules {
		if mod.Problem != nil {
			out = append(out, mod)
		}
	}

	return out
}

// problemCard lists the modules that did not load. Each row links to the
// module page, which names the path that was tried and the config line to fix.
templ problemCard(r configdash.Report) {
	<div class="card border border-error/40 bg-base-100 shadow">
		<div class="card-body">
			<div class="flex items-center justify-between">
				<h2 class="card-title text-base text-error">
					Modules that did not load
					<span class="badge badge-error badge-sm">{ fmt.Sprint(r.ProblemCount()) }</span>
				</h2>
				<a class="link link-hover text-xs" href={ scopeRoute(r.Scope, pageModules) }>details</a>
			</div>
			<p class="text-sm text-base-content/70">
				Everything else in the tree still merged. Each module below is missing from <span class="font-mono">options</span>, and the config referencing it may fail to evaluate.
			</p>
			<ul class="divide-y divide-base-300">
				for _, mod := range problems(r) {
					<li class="py-2">
						<a class="link link-hover font-mono text-sm" href={ scopeRoute(r.Scope, pageModules) + "?name=" + mod.Name }>{ mod.Name }</a>
						if mod.Problem != nil {
							<span class="ml-2 badge badge-sm badge-error">{ mod.Problem.Summary }</span>
							if mod.Problem.Looked != "" {
								<p class="mt-1 truncate font-mono text-xs text-base-content/60" title={ mod.Problem.Looked }>{ mod.Problem.Looked }</p>
							}
						}
					</li>
				}
			</ul>
		</div>
	</div>
}

// unusedCard lists module directories that exist but that no module entry
// points at. They do not load; the entry file decides what does.
templ unusedCard(r configdash.Report) {
	<div class="card border border-base-300 bg-base-100 shadow">
		<div class="card-body">
			<div class="flex items-center justify-between">
				<h2 class="card-title text-base">
					Module directories not used
					<span class="badge badge-ghost badge-sm">{ fmt.Sprint(len(r.Unused)) }</span>
				</h2>
			</div>
			<p class="text-sm text-base-content/70">
				These directories hold a <span class="font-mono">modot.cue</span> but nothing under <span class="font-mono">modules</span> points at them, so they do not load. Reference one with <span class="font-mono">modules.&lt;name&gt;.input</span> to use it.
			</p>
			<ul class="flex flex-wrap gap-2">
				for _, dir := range r.Unused {
					<li class="badge badge-ghost badge-sm font-mono" title={ dir }>{ filepath.Base(dir) }</li>
				}
			</ul>
		</div>
	</div>
}

templ statsRow(cards []statCard) {
	<div class="stats w-full border border-base-300 bg-base-100 shadow">
		for _, card := range cards {
			<div class="stat place-items-center">
				<div class="stat-title">{ card.Title }</div>
				<div class={ "stat-value " + card.Accent }>{ card.Value }</div>
				<div class="stat-desc">{ card.Desc }</div>
			</div>
		}
	</div>
}

templ layerStrip(r configdash.Report) {
	<div class="rounded-box border border-base-300 bg-base-100 p-4">
		<div class="mb-3 flex items-center justify-between">
			<h2 class="text-sm font-semibold tracking-wide uppercase">Discovery order</h2>
			<a class="link link-hover text-xs" href={ scopeRoute(r.Scope, pageLayers) }>details</a>
		</div>
		<div class="flex flex-wrap items-center gap-2">
			for i, layer := range r.Layers {
				if i > 0 {
					<span class="text-base-content/40">→</span>
				}
				<span class="badge badge-lg badge-soft badge-primary" title={ layer.Path }>{ layer.Name }</span>
			}
			<span class="text-base-content/40">→</span>
			<span class="badge badge-lg badge-success">unified</span>
		</div>
	</div>
}

templ topKeysCard(r configdash.Report) {
	<div class="card border border-base-300 bg-base-100 shadow">
		<div class="card-body">
			<h2 class="card-title text-base">Top-level keys</h2>
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<thead>
						<tr><th>Key</th><th>Shape</th><th>Module leaves</th></tr>
					</thead>
					<tbody>
						for _, key := range topLevel(r) {
							<tr>
								<td><a class="link link-hover font-mono" href={ scopeRoute(r.Scope, pageMerged) + "?path=" + key }>{ key }</a></td>
								<td class="font-mono text-xs text-base-content/70">{ shortValue(r.Merged[key]) }</td>
								<td>
									if n := ownedLeaves(r, key); n > 0 {
										<span class="badge badge-sm badge-secondary">{ fmt.Sprint(n) }</span>
									} else {
										<span class="text-xs text-base-content/40">—</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ moduleSummaryCard(r configdash.Report) {
	<div class="card border border-base-300 bg-base-100 shadow">
		<div class="card-body">
			<div class="flex items-center justify-between">
				<h2 class="card-title text-base">Modules</h2>
				<a class="link link-hover text-xs" href={ scopeRoute(r.Scope, pageModules) }>details</a>
			</div>
			<ul class="space-y-1">
				for _, mod := range r.Modules {
					<li class="flex items-center justify-between gap-2 rounded-lg px-2 py-1 hover:bg-base-200">
						<a class="link link-hover font-mono" href={ scopeRoute(r.Scope, pageModules) + "?name=" + mod.Name }>{ mod.Name }</a>
						if mod.Problem != nil {
							<span class="badge badge-sm badge-error" title={ mod.Problem.Summary }>not loaded</span>
						} else if mod.Err != nil {
							<span class="badge badge-sm badge-error" title={ mod.Err.Error() }>error</span>
						} else if mod.Enable {
							<span class="badge badge-sm badge-success">on</span>
						} else {
							<span class="badge badge-sm badge-ghost">off</span>
						}
					</li>
				}
			</ul>
		</div>
	</div>
}
