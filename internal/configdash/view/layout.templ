// Package view renders the config dashboard pages.
package view

import (
	"github.com/lewtec/lewkit/x/http/asset/daisyui"
	"github.com/lewtec/lewkit/x/http/asset/lucide"
	"github.com/lewtec/lewkit/x/http/asset/tailwindcss"
	"github.com/lewtec/modot/internal/configdash"
)

templ BrowserAssets() {
	@daisyui.Load()
	@tailwindcss.Load()
	// The syntax palette is a templ css class set, served once here rather
	// than inlined into every page that shows a file.
	<link rel="stylesheet" href={ templCSSPath }/>
}

templ Document(title, theme string) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ ThemePalette(theme) } data-theme-choice={ themeChoiceAttr(theme) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · modot</title>
			<meta name="color-scheme" content="light dark"/>
			@BrowserAssets()
		</head>
		{ children... }
	</html>
}

// icon draws a Lucide icon sized by a Tailwind class.
templ icon(name lucide.Name, class string) {
	<span class={ "inline-flex shrink-0 " + class } aria-hidden="true">
		@lucide.Icon(name)
	</span>
}

templ Brand() {
	<span class="inline-flex items-center gap-2">
		<span class="grid size-8 place-items-center rounded-lg bg-primary text-primary-content">
			@icon(lucide.NameLayers, "size-5")
		</span>
		<span class="text-lg font-semibold tracking-tight">modot</span>
	</span>
}

templ themeToggle(theme string) {
	<div class="tabs tabs-box tabs-xs" role="tablist" title="Theme">
		for _, choice := range []string{"system", "light", "dark"} {
			<a href="#" class={ toggleClass(choice, theme) } data-theme-set={ choice } role="tab" aria-selected={ boolAttr(choice == theme) }>
				@themeIcon(choice)
			</a>
		}
	</div>
}

// themeIcon draws the pictogram for one theme choice.
templ themeIcon(choice string) {
	if choice == "system" {
		@icon(lucide.NameMonitor, "size-4")
	} else if choice == "dark" {
		@icon(lucide.NameMoon, "size-4")
	} else {
		@icon(lucide.NameSun, "size-4")
	}
}

templ navItem(href, label, current string) {
	<li>
		if current == href {
			<a href={ href } class="menu-active rounded-none" aria-current="page">{ label }</a>
		} else {
			<a href={ href } class="rounded-none">{ label }</a>
		}
	</li>
}

// scopeTitle names the layer set the switcher shows.
func scopeTitle(scope configdash.Scope) string {
	switch scope {
	case configdash.ScopeHome:
		return "Home"
	case configdash.ScopeCodebase:
		return "Codebase"
	case configdash.ScopeSystem:
		return "System"
	}

	return string(scope)
}

// scopeToggle switches layer set. Each scope is its own route, so the links are
// plain paths; the current scope is the active tab.
templ scopeToggle(v View) {
	<div class="tabs tabs-box tabs-sm" role="tablist" title="Layer set">
		for _, scope := range Scopes() {
			<a href={ scopeRoute(scope, pageOverview) } class={ scopeClass(scope, v.Scope) } role="tab" aria-selected={ boolAttr(scope == v.Scope) }>
				{ scopeTitle(scope) }
			</a>
		}
	</div>
}

templ Sidebar(current string, v View) {
	<nav class="menu menu-sm w-full gap-0 p-2">
		<li class="menu-title px-3 py-2 text-[0.65rem] tracking-wider uppercase"><span>{ scopeTitle(v.Scope) } layers</span></li>
		@navItem(scopeRoute(v.Scope, pageOverview), "Overview", current)
		@navItem(scopeRoute(v.Scope, pageLayers), "Layers", current)
		@navItem(scopeRoute(v.Scope, pageModules), "Modules", current)
		<li class="menu-title mt-2 px-3 py-2 text-[0.65rem] tracking-wider uppercase"><span>Data</span></li>
		@navItem(scopeRoute(v.Scope, pageMerged), "Merged tree", current)
		@navItem(scopeRoute(v.Scope, pageMerged)+".json", "Merged JSON", current)
		@navItem(scopeRoute(v.Scope, pageFiles), "Materialized files", current)
	</nav>
}

// Shell is the page frame: header, sidebar, and scrollable body. theme is the
// choice (system, light, dark); the page starts on the palette that choice
// implies and the client script corrects "system" before anything is visible.
templ Shell(title string, current page, theme string, v View) {
	@Document(title, theme) {
		<body class="h-screen min-h-screen overflow-hidden bg-base-200 text-base-content">
			<div class="flex h-full min-h-0 flex-col">
				<header class="navbar z-50 h-12 min-h-12 shrink-0 border-b border-base-300 bg-base-100 px-2 sm:px-4">
					<div class="navbar-start gap-1">
						<a href={ scopeRoute(v.Scope, pageOverview) } class="btn btn-ghost h-10 min-h-10 px-1.5 sm:px-2" aria-label="modot — overview">
							@Brand()
						</a>
						@scopeToggle(v)
					</div>
					<div class="navbar-end gap-2">
						@themeToggle(theme)
					</div>
				</header>
				<div class="relative flex min-h-0 flex-1">
					<aside class="flex w-56 shrink-0 flex-col overflow-y-auto border-r border-base-300 bg-base-100">
						@Sidebar(string(current), v)
					</aside>
					<div class="flex min-h-0 min-w-0 flex-1 flex-col">
						<main class="min-h-0 flex-1 overflow-y-auto">
							<div class="w-full px-4 py-8 sm:px-6 sm:py-10 lg:px-10">
								{ children... }
							</div>
						</main>
					</div>
				</div>
			</div>
			<script>
				// Theme choices are light, dark, and system. "system" follows
				// prefers-color-scheme and is the default when no cookie is set.
				// The class only applies to the resolved palette; the choice
				// itself is kept in the cookie.
				(function () {
					var root = document.documentElement;
					var dark = window.matchMedia("(prefers-color-scheme: dark)");
					var choice = root.getAttribute("data-theme-choice") || "system";

					function apply() {
						var resolved = choice === "system" ? (dark.matches ? "dark" : "light") : choice;
						root.setAttribute("data-theme", resolved);
						document.querySelectorAll("[data-theme-set]").forEach(function (el) {
							var on = el.getAttribute("data-theme-set") === choice;
							el.classList.toggle("tab-active", on);
							el.setAttribute("aria-selected", on ? "true" : "false");
						});
					}

					document.querySelectorAll("[data-theme-set]").forEach(function (el) {
						el.addEventListener("click", function (event) {
							event.preventDefault();
							choice = el.getAttribute("data-theme-set");
							root.setAttribute("data-theme-choice", choice);
							document.cookie = "modot_theme=" + choice + "; path=/; max-age=31536000; SameSite=Lax";
							apply();
						});
					});
					dark.addEventListener("change", function () {
						if (choice === "system") {
							apply();
						}
					});
					apply();
				})();
			</script>
		</body>
	}
}

// PageHeader renders the title block. The page body is a separate component so
// a page can put anything under it.
templ PageHeader(title, lead string) {
	<header class="mb-6 w-full space-y-2">
		<h1 class="text-3xl font-semibold tracking-tight">{ title }</h1>
		if lead != "" {
			<p class="text-base-content/70">{ lead }</p>
		}
	</header>
}

templ PageBody() {
	<div class="w-full space-y-6">
		{ children... }
	</div>
}

func scopeClass(value, current configdash.Scope) string {
	if value == current {
		return tabBase + " tab-active"
	}
	return tabBase
}

func toggleClass(value, current string) string {
	if value == current {
		return tabBase + " tab-active"
	}
	return tabBase
}

// themeChoiceAttr is the theme choice the client script starts from: the cookie
// value, or "system" when nothing was chosen.
func themeChoiceAttr(theme string) string {
	if theme == ThemeLight || theme == ThemeDark {
		return theme
	}

	return ThemeSystem
}

func boolAttr(v bool) string {
	if v {
		return "true"
	}
	return "false"
}
