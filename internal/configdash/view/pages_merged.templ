package view

import (
	"fmt"
	"path/filepath"
	"sort"
	"strings"

	"github.com/lewtec/modot/internal/configdash"
)

// node is one row of the merged tree.
type node struct {
	// Key is the field label; Path is the dotted path from the root.
	Key   string
	Path  string
	Depth int
	// Children are nil for a leaf.
	Children []node
	// Value is the rendered scalar, or the shape summary for a container.
	Value string
	// Owner is the module that supplied the path, or "" for base config.
	Owner string
	// Filename is the file CUE recorded for the value, or "" when nothing
	// recorded one (a computed value, or a generated layer).
	Filename string
	// Files are the files that set the leaves under a container, so a folded
	// subtree still says where it came from.
	Files []fileCount
	// Open means the subtree renders expanded.
	Open bool
}

// buildTree renders nodePath of merged as rows. An empty nodePath renders the
// whole tree. A container is expanded when it is the node itself or a prefix of
// the node, so the selected path is always visible.
func buildTree(r configdash.Report, nodePath string) []node {
	var value any = r.Merged
	base := ""
	if nodePath != "" {
		found, ok := lookup(r.Merged, strings.Split(nodePath, "."))
		if !ok {
			return nil
		}
		value = found
		base = nodePath
	}
	return walkNode(r, base, value, 0, nodePath)
}

func walkNode(r configdash.Report, path string, value any, depth int, focus string) []node {
	obj, ok := value.(map[string]any)
	if !ok {
		return nil
	}
	keys := make([]string, 0, len(obj))
	for key := range obj {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	out := make([]node, 0, len(keys))
	for _, key := range keys {
		childPath := joinPath(path, key)
		owner := ""
		if src, ok := r.Sources[childPath]; ok && src.Owned() {
			owner = src.Module
		}
		row := node{Key: key, Path: childPath, Depth: depth, Owner: owner, Filename: filenameOf(r, childPath), Value: shortValue(obj[key])}
		if _, isMap := obj[key].(map[string]any); isMap {
			row.Open = focus == "" || childPath == focus || strings.HasPrefix(childPath, focus+".") || strings.HasPrefix(focus, childPath+".")
			row.Children = walkNode(r, childPath, obj[key], depth+1, focus)
			row.Files = leafFiles(row.Children)
		}
		out = append(out, row)
	}
	return out
}

// filenameOf is the base name of the file that set a leaf: the record CUE kept
// for it, or the module file when the module owns the key and no record exists.
func filenameOf(r configdash.Report, path string) string {
	if file, ok := r.Files[path]; ok {
		return filepath.Base(file)
	}
	src, ok := r.Sources[path]
	if !ok {
		return ""
	}
	if src.Owned() {
		for _, mod := range r.Modules {
			if mod.Name == src.Module {
				return modotFile
			}
		}
	}

	return src.Filename()
}

// modotFile names every module fragment; the badge shows the directory that
// holds it instead, through the owning module.
const modotFile = "modot.cue"

// fileCount is one file under a container and how many leaves it set.
type fileCount struct {
	File  string
	Leaves int
}

// leafFiles rolls the leaves under a container up to the files that set them,
// most leaves first, so a folded row still says where its contents came from.
func leafFiles(rows []node) []fileCount {
	counts := map[string]int{}
	var walk func(rows []node)
	walk = func(rows []node) {
		for _, row := range rows {
			if row.Children != nil {
				walk(row.Children)

				continue
			}
			if row.Filename != "" {
				counts[row.Filename]++
			}
		}
	}
	walk(rows)
	out := make([]fileCount, 0, len(counts))
	for file, leaves := range counts {
		out = append(out, fileCount{File: file, Leaves: leaves})
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].Leaves != out[j].Leaves {
			return out[i].Leaves > out[j].Leaves
		}

		return out[i].File < out[j].File
	})

	return out
}

func lookup(root map[string]any, parts []string) (any, bool) {
	var current any = root
	for _, part := range parts {
		obj, ok := current.(map[string]any)
		if !ok {
			return nil, false
		}
		current, ok = obj[part]
		if !ok {
			return nil, false
		}
	}
	return current, true
}

func joinPath(prefix, key string) string {
	if prefix == "" {
		return key
	}
	return prefix + "." + key
}

func nodeKind(row node) string {
	if row.Children != nil {
		return fmt.Sprintf("{%d}", len(row.Children))
	}
	return row.Value
}

templ treeRows(rows []node) {
	for _, row := range rows {
		<li>
			if row.Children != nil {
				<details open?={ row.Open }>
					<summary class="flex cursor-pointer flex-wrap items-center gap-2 rounded px-2 py-1 hover:bg-base-200">
						<span class="font-mono text-sm font-semibold">{ row.Key }</span>
						<span class="font-mono text-xs text-base-content/40">{ nodeKind(row) }</span>
						if row.Owner != "" {
							<span class="badge badge-xs badge-secondary">{ row.Owner }</span>
						}
						@fileBadges(row.Files)
					</summary>
					<ul class="ml-4 border-l border-base-300 pl-2">
						@treeRows(row.Children)
					</ul>
				</details>
			} else {
				<div class="flex items-center gap-2 rounded px-2 py-1 hover:bg-base-200">
					<span class="font-mono text-sm">{ row.Key }</span>
					<span class="font-mono text-xs text-base-content/70">{ row.Value }</span>
					@ownerBadge(row.Owner, row.Filename)
				</div>
			}
		</li>
	}
}

// fileBadges lists where a folded container's leaves came from. Only the files
// with the most leaves show, so a container fed by many modules stays readable.
templ fileBadges(files []fileCount) {
	if len(files) > 0 {
		<span class="flex flex-wrap items-center gap-1 text-xs text-base-content/50" title={ fileCountTitle(files) }>
			for i, file := range head(files, 3) {
				if i > 0 {
					<span>·</span>
				}
				<span class="font-mono">{ file.File }</span>
			}
			if len(files) > 3 {
				<span>+{ fmt.Sprint(len(files) - 3) }</span>
			}
		</span>
	}
}

// fileCountTitle is the full list behind the badges, one file per line.
func fileCountTitle(files []fileCount) string {
	lines := make([]string, 0, len(files))
	for _, file := range files {
		lines = append(lines, fmt.Sprintf("%s (%d leaves)", file.File, file.Leaves))
	}

	return strings.Join(lines, "\n")
}

// head returns the first n entries of files.
func head(files []fileCount, n int) []fileCount {
	if len(files) <= n {
		return files
	}

	return files[:n]
}

// ownerBadge marks a leaf with the file that set it, and the module when a
// module owns the key. "modot.cue" alone is ambiguous across 26 modules, so a
// module leaf leads with the module; a base leaf shows the file that won it.
templ ownerBadge(owner, filename string) {
	if owner != "" && filename != "" && filename != modotFile {
		<span class="badge badge-xs badge-secondary" title={ fileTitle(owner, filename) }>{ owner + "/" + filename }</span>
	} else if owner != "" {
		<span class="badge badge-xs badge-secondary" title={ fileTitle(owner, filename) }>{ owner }</span>
	} else if filename != "" {
		<span class="badge badge-xs badge-ghost" title={ "set by " + filename }>{ filename }</span>
	} else {
		<span class="badge badge-xs badge-outline" title="no file recorded: set by a computed or generated layer">computed</span>
	}
}

// fileTitle is the full tooltip for a leaf badge.
func fileTitle(owner, filename string) string {
	if filename == "" {
		return "set by module " + owner + "; no file recorded"
	}

	return "set by module " + owner + " (" + filename + ")"
}

templ Merged(v View) {
	@Shell("Merged tree", pageMerged, v.Theme, v) {
		@PageHeader("Merged tree", "The unified Configuration. Every leaf names the file whose assertion won it, down to the value, and the module when a module owns the key.")
			@PageBody() {
				if v.LoadErr != nil {
					@errorAlert(v.LoadErr)
				} else if v.shown().MergedErr != nil {
					@errorAlert(v.shown().MergedErr)
				} else {
					<div class="flex flex-wrap items-center gap-2">
						<a class="btn btn-xs btn-ghost" href={ scopeRoute(v.Scope, pageMerged) }>root</a>
						if v.Path != "" {
							<span class="font-mono text-xs text-base-content/60">{ v.Path }</span>
						}
					</div>
					<div class="rounded-box border border-base-300 bg-base-100 p-3">
						<ul class="space-y-0.5">
							@treeRows(buildTree(v.shown(), v.Path))
						</ul>
					</div>
				}
			}
	}
}
