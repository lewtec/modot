package view

import (
	"fmt"

	"github.com/lewtec/modot/internal/configdash"
)

templ ModuleOptions(mod configdash.Module) {
	<div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
		<div class="flex min-w-0 flex-col rounded-box border border-base-300 bg-base-100">
			<div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
				<h3 class="text-sm font-semibold">Schema (<span class="font-mono">options</span>)</h3>
				<span class="badge badge-sm badge-soft badge-secondary">{ fmt.Sprint(len(mod.RootKeys)) } root key(s)</span>
			</div>
			if mod.Err != nil {
				<p class="p-4 text-sm text-error">{ mod.Err.Error() }</p>
			} else {
				<pre class="max-h-[32rem] overflow-auto p-4 font-mono text-xs leading-relaxed">{ mod.OptionsCUE }</pre>
			}
		</div>
		<div class="flex min-w-0 flex-col rounded-box border border-base-300 bg-base-100">
			<div class="flex items-center justify-between border-b border-base-300 px-4 py-3">
				<h3 class="text-sm font-semibold">Merged <span class="font-mono">{ "options." + mod.Name }</span></h3>
				<a class="link link-hover text-xs" href={ "/merged?path=options." + mod.Name }>in tree</a>
			</div>
			if mod.Merged == nil {
				<p class="p-4 text-sm text-base-content/60">No values resolved for this module.</p>
			} else {
				<pre class="max-h-[32rem] overflow-auto p-4 font-mono text-xs leading-relaxed">{ prettyJSON(mod.Merged) }</pre>
			}
		</div>
	</div>
}

templ Modules(v View) {
	@Shell("Modules", "/modules", v.Theme) {
		@PageHeader("Modules", "Each module declares configuration as a top-level options field. The loader strips it from the fragment and injects it into the shared tree under the module's name.")
			@PageBody() {
				if v.LoadErr != nil {
					@errorAlert(v.LoadErr)
				} else if len(v.shown().Modules) == 0 {
					<div class="rounded-box border border-dashed border-base-300 bg-base-100 p-16 text-center text-base-content/50">
						<p class="font-semibold italic">No modules named by this entry file</p>
					</div>
				} else {
					<div class="tabs tabs-box w-fit">
						for _, mod := range v.shown().Modules {
							if mod.Name == v.ModuleName {
								<a class="tab tab-active" href={ "/modules?name=" + mod.Name }>{ mod.Name }</a>
							} else {
								<a class="tab" href={ "/modules?name=" + mod.Name }>{ mod.Name }</a>
							}
						}
					</div>
					if mod, ok := v.selectedModule(); ok {
						<div class="rounded-box border border-base-300 bg-base-100 p-4">
							<div class="mb-1 flex flex-wrap items-center gap-2">
								<span class="font-mono text-base font-semibold">{ mod.Name }</span>
								if mod.Err != nil {
									<span class="badge badge-error badge-sm">error</span>
								} else if mod.Enable {
									<span class="badge badge-success badge-sm">enabled</span>
								} else {
									<span class="badge badge-ghost badge-sm">disabled</span>
								}
							</div>
							<p class="truncate font-mono text-xs text-base-content/60" title={ mod.Path }>{ mod.Path }</p>
						</div>
						@ModuleOptions(mod)
					}
				}
			}
	}
}
